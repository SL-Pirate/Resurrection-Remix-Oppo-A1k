# Only partitions observed in this handset's GPT are listed.
/system_root ext4 /dev/block/platform/bootdevice/by-name/system flags=display="System";backup=1;wipeingui
# TWRP 9 requires a separate raw partition entry for filesystem image flashing.
/system_image emmc /dev/block/platform/bootdevice/by-name/system flags=display="System Image";backup=1;flashimg=1
/vendor ext4 /dev/block/platform/bootdevice/by-name/vendor flags=display="Vendor";backup=1;mounttodecrypt
/odm ext4 /dev/block/platform/bootdevice/by-name/odm flags=display="ODM";backup=1;mounttodecrypt;fsflags=ro
/data ext4 /dev/block/platform/bootdevice/by-name/userdata flags=display="Data";backup=1;fileencryption=aes-256-xts
/cache ext4 /dev/block/platform/bootdevice/by-name/cache flags=display="Cache";backup=1;wipeingui
/boot emmc /dev/block/platform/bootdevice/by-name/boot flags=display="Boot";backup=1;flashimg=1
/recovery emmc /dev/block/platform/bootdevice/by-name/recovery flags=display="Recovery";backup=1;flashimg=1
/misc emmc /dev/block/platform/bootdevice/by-name/para
# Keep radio calibration and device-specific storage as raw backup entries.
/nvram emmc /dev/block/platform/bootdevice/by-name/nvram flags=display="NVRAM";backup=1
/nvdata emmc /dev/block/platform/bootdevice/by-name/nvdata flags=display="NVDATA";backup=1
/nvcfg emmc /dev/block/platform/bootdevice/by-name/nvcfg flags=display="NVCFG";backup=1
/protect1 emmc /dev/block/platform/bootdevice/by-name/protect1 flags=display="Protect1";backup=1
/protect2 emmc /dev/block/platform/bootdevice/by-name/protect2 flags=display="Protect2";backup=1
/persist emmc /dev/block/platform/bootdevice/by-name/persist flags=display="Persist";backup=1
/external_sd auto /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=display="MicroSD";storage;wipeingui;removable
